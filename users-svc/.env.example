# Postgres credentials (used by both the users-db container and this service)
POSTGRES_USER=users_app
POSTGRES_PASSWORD=changeme
POSTGRES_DB=users_db

# Connection string Prisma uses — host must match the users-db service name in docker-compose.yml
DATABASE_URL=postgresql://users_app:changeme@users-db:5432/users_db

# App
PORT=8003
JWT_SECRET=changeme-generate-a-long-random-string-shared-with-booking-svc-and-fitflow-mcp

# Consul
CONSUL_HOST=consul
CONSUL_PORT=8500
