generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  message   String
  channel   String   @default("log")
  status    String   @default("sent")
  createdAt DateTime @default(now())
}
